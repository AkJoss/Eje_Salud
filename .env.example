APP_NAME=Eje Salud API
DEBUG=false

# MySQL 8+ (recomendado): usuario/clave/host/base con charset utf8mb4
# Si la contraseña tiene @ o caracteres especiales, codifícala (urllib.parse.quote_plus).
DATABASE_URL=mysql+pymysql://app:appsecret@127.0.0.1:3306/eje_salud?charset=utf8mb4

# SQLite solo para pruebas locales puntuales:
# DATABASE_URL=sqlite:///./eje_salud.db

JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480

FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: creates first admin if table is empty (dev/bootstrap only)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_WRITE=20/minute
