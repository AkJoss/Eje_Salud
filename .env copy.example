APP_NAME=Eje Salud API
DEBUG=false

# SQLite (dev): sqlite:///./eje_salud.db
# Postgres (prod): postgresql+psycopg://user:pass@localhost:5432/eje_salud
DATABASE_URL=sqlite:///./eje_salud.db

JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480

FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: creates first admin if table is empty (dev/bootstrap only)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_WRITE=20/minute
